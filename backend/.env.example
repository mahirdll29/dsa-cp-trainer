DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
JWT_SECRET="replace-with-a-long-random-string"
PORT=5000
FRONTEND_URL="http://localhost:3000"
NODE_ENV="development"
# Module 6 (AI layer). UNLIKE JWT_SECRET this deliberately does NOT fail fast:
# if it is missing the server still boots, every other endpoint works, and only
# /api/ai/* returns 503. The recommendation engine is correct with AI off, so
# the AI is not load-bearing — see architecture.md 7.
GROQ_API_KEY="your_groq_api_key"

# The model is config, not code, because Groq's lineup changes often. The
# default below is verified present and active, with JSON mode supported.
GROQ_MODEL="openai/gpt-oss-120b"

# Only overridden to point at a local stub when verifying the failure paths.
# GROQ_BASE_URL="https://api.groq.com/openai/v1"

# LeetCode has NO official public API. This is the community-maintained
# alfa-leetcode-api wrapper. Overriding it lets you point at a self-hosted
# instance (the project ships a Docker image) without touching code.
LEETCODE_API_URL=https://alfa-leetcode-api.onrender.com
